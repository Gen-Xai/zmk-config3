#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        sft_one_excl: sft_one_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp EXCL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sft_two_qmark: sft_two_qmark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp QMARK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        saikaku {
            bindings = <
&mo 1  &kp N1  &kp NUMBER_2  &kp N3  &kp N4  &kp N5  &kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp TAB  &kp A  &kp S  &kp D  &kp F  &kp G  &kp LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp LEFT_CONTROL  &kp LEFT_WIN  &kp PSCRN  &kp LALT  &kp INT_MUHENKAN  &kp SPACE  &mo 1  &kp N0  &kp N9  &kp N8  &kp N7  &kp N6  &kp C_MUTE  &kp P  &kp O  &kp I  &kp U  &kp Y  &kp C_VOL_UP  &kp MINUS  &kp L  &kp K  &kp J  &kp H  &kp C_VOL_DN  &kp UP  &kp DOT  &kp COMMA  &kp M  &kp N  &kp RIGHT  &kp DOWN  &kp LEFT  &kp RALT  &kp INTERNATIONAL_4  &kp ENTER
            >;
        };

        syouki {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LALT  &trans  &kp BSPC  &trans  &bt BT_SEL 0  &kp F3  &kp F2  &kp F1  &trans  &bt BT_CLR  &bt BT_SEL 1  &kp F6  &kp F5  &kp F4  &trans  &kp C_BRI_UP  &bt BT_SEL 2  &kp F9  &kp F8  &kp F7  &trans  &kp C_BRI_DN  &kp PG_UP  &kp F12  &kp F11  &kp F10  &trans  &kp END  &kp PG_DN  &kp HOME  &trans  &trans  &kp DEL
            >;
        };
    };
};
